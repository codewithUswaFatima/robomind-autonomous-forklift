<?xml version="1.0"?>
<rdf:RDF xmlns="ttp://www.semanticweb.org/h/"
     xml:base="ttp://www.semanticweb.org/h/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:forklift="http://example.org/forklift#">
    <owl:Ontology rdf:about="http://example.org/forklift"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/forklift#carries -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#carries">
        <rdfs:domain rdf:resource="http://example.org/forklift#AutonomousForklift"/>
        <rdfs:range rdf:resource="http://example.org/forklift#Load"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/forklift#causes -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#causes">
        <rdfs:domain rdf:resource="http://example.org/forklift#Fault"/>
        <rdfs:range rdf:resource="http://example.org/forklift#RecoveryAction"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/forklift#detects -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#detects">
        <rdfs:domain rdf:resource="http://example.org/forklift#Sensor"/>
        <rdfs:range rdf:resource="http://example.org/forklift#Hazard"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/forklift#hasComponent -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#hasComponent">
        <rdfs:domain rdf:resource="http://example.org/forklift#AutonomousForklift"/>
        <rdfs:range rdf:resource="http://example.org/forklift#Component"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/forklift#hasFault -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#hasFault">
        <rdfs:domain rdf:resource="http://example.org/forklift#AutonomousForklift"/>
        <rdfs:range rdf:resource="http://example.org/forklift#Fault"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/forklift#locatedIn -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#locatedIn">
        <rdfs:domain rdf:resource="http://example.org/forklift#AutonomousForklift"/>
        <rdfs:range rdf:resource="http://example.org/forklift#Zone"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/forklift#performs -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#performs">
        <rdfs:domain rdf:resource="http://example.org/forklift#AutonomousForklift"/>
        <rdfs:range rdf:resource="http://example.org/forklift#Task"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/forklift#triggers -->

    <owl:ObjectProperty rdf:about="http://example.org/forklift#triggers">
        <rdfs:domain rdf:resource="http://example.org/forklift#Hazard"/>
        <rdfs:range rdf:resource="http://example.org/forklift#RecoveryAction"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/forklift#Actuator -->

    <owl:Class rdf:about="http://example.org/forklift#Actuator">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Component"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Battery"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Sensor"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Aisle -->

    <owl:Class rdf:about="http://example.org/forklift#Aisle">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Zone"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#AutonomousForklift -->

    <owl:Class rdf:about="http://example.org/forklift#AutonomousForklift">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Robot"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/forklift#hasComponent"/>
                <owl:someValuesFrom rdf:resource="http://example.org/forklift#Battery"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/forklift#hasComponent"/>
                <owl:someValuesFrom rdf:resource="http://example.org/forklift#LidarSensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/forklift#Battery -->

    <owl:Class rdf:about="http://example.org/forklift#Battery">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Component"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Sensor"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#BlockedAisle -->

    <owl:Class rdf:about="http://example.org/forklift#BlockedAisle">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Hazard"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/forklift#triggers"/>
                <owl:someValuesFrom rdf:resource="http://example.org/forklift#Reroute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://example.org/forklift#PersonInPath"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#UnstableLoad"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Brake -->

    <owl:Class rdf:about="http://example.org/forklift#Brake">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Actuator"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#CameraSensor -->

    <owl:Class rdf:about="http://example.org/forklift#CameraSensor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Sensor"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#ChargeTask -->

    <owl:Class rdf:about="http://example.org/forklift#ChargeTask">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Task"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#ChargingStation -->

    <owl:Class rdf:about="http://example.org/forklift#ChargingStation">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Zone"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Component -->

    <owl:Class rdf:about="http://example.org/forklift#Component">
        <owl:disjointWith rdf:resource="http://example.org/forklift#Fault"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#FloorCondition"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Hazard"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Load"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#OtherVehicle"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Person"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#RecoveryAction"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Robot"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Task"/>
        <owl:disjointWith rdf:resource="http://example.org/forklift#Zone"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#DriveMotor -->

    <owl:Class rdf:about="http://example.org/forklift#DriveMotor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Actuator"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Fault -->

    <owl:Class rdf:about="http://example.org/forklift#Fault"/>
    


    <!-- http://example.org/forklift#FloorCondition -->

    <owl:Class rdf:about="http://example.org/forklift#FloorCondition"/>
    


    <!-- http://example.org/forklift#Fork -->

    <owl:Class rdf:about="http://example.org/forklift#Fork">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Actuator"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#ForkliftAtChargingStation -->

    <owl:Class rdf:about="http://example.org/forklift#ForkliftAtChargingStation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/forklift#AutonomousForklift"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/forklift#locatedIn"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/forklift#ChargingStation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/forklift#ForkliftInAisle -->

    <owl:Class rdf:about="http://example.org/forklift#ForkliftInAisle">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/forklift#AutonomousForklift"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/forklift#locatedIn"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/forklift#Aisle"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/forklift#ForkliftNeedingRecharge -->

    <owl:Class rdf:about="http://example.org/forklift#ForkliftNeedingRecharge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/forklift#AutonomousForklift"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/forklift#hasFault"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/forklift#LowBattery"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/forklift#ForkliftWithFault -->

    <owl:Class rdf:about="http://example.org/forklift#ForkliftWithFault">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/forklift#AutonomousForklift"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/forklift#hasFault"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/forklift#Fault"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#AutonomousForklift"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#FragileLoad -->

    <owl:Class rdf:about="http://example.org/forklift#FragileLoad">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Load"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#FragileLoadCarrier -->

    <owl:Class rdf:about="http://example.org/forklift#FragileLoadCarrier">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/forklift#AutonomousForklift"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/forklift#carries"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/forklift#FragileLoad"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/forklift#Hazard -->

    <owl:Class rdf:about="http://example.org/forklift#Hazard"/>
    


    <!-- http://example.org/forklift#HeavyLoad -->

    <owl:Class rdf:about="http://example.org/forklift#HeavyLoad">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Load"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#HeavyLoadCarrier -->

    <owl:Class rdf:about="http://example.org/forklift#HeavyLoadCarrier">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/forklift#AutonomousForklift"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/forklift#carries"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/forklift#HeavyLoad"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/forklift#Intersection -->

    <owl:Class rdf:about="http://example.org/forklift#Intersection">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Zone"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#LidarSensor -->

    <owl:Class rdf:about="http://example.org/forklift#LidarSensor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Sensor"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Load -->

    <owl:Class rdf:about="http://example.org/forklift#Load"/>
    


    <!-- http://example.org/forklift#LoadWeightSensor -->

    <owl:Class rdf:about="http://example.org/forklift#LoadWeightSensor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Sensor"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#LoadingDock -->

    <owl:Class rdf:about="http://example.org/forklift#LoadingDock">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Zone"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#LowBattery -->

    <owl:Class rdf:about="http://example.org/forklift#LowBattery">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Fault"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/forklift#causes"/>
                <owl:someValuesFrom rdf:resource="http://example.org/forklift#Recharge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/forklift#ManualForklift -->

    <owl:Class rdf:about="http://example.org/forklift#ManualForklift">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#OtherVehicle"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Mast -->

    <owl:Class rdf:about="http://example.org/forklift#Mast">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Actuator"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#NarrowDoorway -->

    <owl:Class rdf:about="http://example.org/forklift#NarrowDoorway">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Zone"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#OtherVehicle -->

    <owl:Class rdf:about="http://example.org/forklift#OtherVehicle"/>
    


    <!-- http://example.org/forklift#Pallet -->

    <owl:Class rdf:about="http://example.org/forklift#Pallet">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Load"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Person -->

    <owl:Class rdf:about="http://example.org/forklift#Person"/>
    


    <!-- http://example.org/forklift#PersonInPath -->

    <owl:Class rdf:about="http://example.org/forklift#PersonInPath">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Hazard"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/forklift#triggers"/>
                <owl:someValuesFrom rdf:resource="http://example.org/forklift#Stop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://example.org/forklift#UnstableLoad"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#PickTask -->

    <owl:Class rdf:about="http://example.org/forklift#PickTask">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Task"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Recharge -->

    <owl:Class rdf:about="http://example.org/forklift#Recharge">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#RecoveryAction"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#RecoveryAction -->

    <owl:Class rdf:about="http://example.org/forklift#RecoveryAction"/>
    


    <!-- http://example.org/forklift#Reroute -->

    <owl:Class rdf:about="http://example.org/forklift#Reroute">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#RecoveryAction"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Robot -->

    <owl:Class rdf:about="http://example.org/forklift#Robot"/>
    


    <!-- http://example.org/forklift#Sensor -->

    <owl:Class rdf:about="http://example.org/forklift#Sensor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Component"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#SensorFault -->

    <owl:Class rdf:about="http://example.org/forklift#SensorFault">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Fault"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/forklift#causes"/>
                <owl:someValuesFrom rdf:resource="http://example.org/forklift#Stop"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/forklift#SlowDown -->

    <owl:Class rdf:about="http://example.org/forklift#SlowDown">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#RecoveryAction"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Stop -->

    <owl:Class rdf:about="http://example.org/forklift#Stop">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#RecoveryAction"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Supervisor -->

    <owl:Class rdf:about="http://example.org/forklift#Supervisor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Person"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Task -->

    <owl:Class rdf:about="http://example.org/forklift#Task"/>
    


    <!-- http://example.org/forklift#TiltSensor -->

    <owl:Class rdf:about="http://example.org/forklift#TiltSensor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Sensor"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#TransportTask -->

    <owl:Class rdf:about="http://example.org/forklift#TransportTask">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Task"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#UnstableLoad -->

    <owl:Class rdf:about="http://example.org/forklift#UnstableLoad">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Hazard"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/forklift#triggers"/>
                <owl:someValuesFrom rdf:resource="http://example.org/forklift#SlowDown"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/forklift#WetFloor -->

    <owl:Class rdf:about="http://example.org/forklift#WetFloor">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#FloorCondition"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Worker -->

    <owl:Class rdf:about="http://example.org/forklift#Worker">
        <rdfs:subClassOf rdf:resource="http://example.org/forklift#Person"/>
    </owl:Class>
    


    <!-- http://example.org/forklift#Zone -->

    <owl:Class rdf:about="http://example.org/forklift#Zone"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/forklift#Aisle_A -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#Aisle_A">
        <rdf:type rdf:resource="http://example.org/forklift#Aisle"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#Aisle_B2 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#Aisle_B2">
        <rdf:type rdf:resource="http://example.org/forklift#Aisle"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#Battery_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#Battery_01">
        <rdf:type rdf:resource="http://example.org/forklift#Battery"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#BlockedAisle_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#BlockedAisle_01">
        <rdf:type rdf:resource="http://example.org/forklift#BlockedAisle"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#ChargeTask_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#ChargeTask_01">
        <rdf:type rdf:resource="http://example.org/forklift#ChargeTask"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#ChargingStation_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#ChargingStation_01">
        <rdf:type rdf:resource="http://example.org/forklift#ChargingStation"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#Forklift_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#Forklift_01">
        <rdf:type rdf:resource="http://example.org/forklift#AutonomousForklift"/>
        <forklift:carries rdf:resource="http://example.org/forklift#HeavyLoad_01"/>
        <forklift:hasComponent rdf:resource="http://example.org/forklift#Battery_01"/>
        <forklift:hasComponent rdf:resource="http://example.org/forklift#LidarSensor_01"/>
        <forklift:hasFault rdf:resource="http://example.org/forklift#LowBattery_01"/>
        <forklift:locatedIn rdf:resource="http://example.org/forklift#Aisle_A"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#Forklift_02 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#Forklift_02">
        <rdf:type rdf:resource="http://example.org/forklift#AutonomousForklift"/>
        <forklift:carries rdf:resource="http://example.org/forklift#Pallet_01"/>
        <forklift:locatedIn rdf:resource="http://example.org/forklift#ChargingStation_01"/>
        <forklift:performs rdf:resource="http://example.org/forklift#ChargeTask_01"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#HeavyLoad_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#HeavyLoad_01">
        <rdf:type rdf:resource="http://example.org/forklift#HeavyLoad"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#LidarSensor_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#LidarSensor_01">
        <rdf:type rdf:resource="http://example.org/forklift#LidarSensor"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#LowBattery_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#LowBattery_01">
        <rdf:type rdf:resource="http://example.org/forklift#LowBattery"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/forklift#ManualForklift_01 -->

    <owl:NamedIndividual rdf:about="http://example.org/forklift#ManualForklift_01">
        <rdf:type rdf:resource="http://example.org/forklift#ManualForklift"/>
    </owl:NamedIndividual>
    


